# Copy this file to .env and fill in your values
# .env is git-ignored and must never be committed

# OpenAI backend
OPENAI_API_KEY=

# Anthropic/Claude backend
ANTHROPIC_API_KEY=

# Ollama (local, no key required)
ARIA_OLLAMA_HOST=http://localhost:11434
# Per-stage model split — expansion (query_expansion.py) and synthesis
# (llm.py) are independent knobs. eval/expansion_cache.json's 80.0/91.7-92
# reference scores are certified against gemma3:4b doing expansion; don't
# change ARIA_EXPANSION_MODEL without re-certifying those numbers.
ARIA_EXPANSION_MODEL=gemma3:4b
ARIA_SYNTHESIS_MODEL=ministral-3:8b
# Deprecated: if set, overrides BOTH of the above for backward compatibility
# with single-model setups. Leave unset once using the split vars above.
ARIA_OLLAMA_MODEL=

# Optional overrides
ARIA_LLM_BACKEND=openai         # openai | ollama | claude
ARIA_CHAT_MODEL=gpt-4.1-mini
ARIA_CLAUDE_MODEL=claude-opus-4-6
ARIA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
ARIA_MAX_FILES=                 # leave empty for no limit
ARIA_MIN_ALPHA_RATIO=0.55
ARIA_NUM_PREDICT=1280           # synthesis generation cap (tokens)
ARIA_NUM_CTX=8192               # synthesis context window (tokens)
# `serve` refuses to start if either Ollama model isn't 100% GPU-resident
# (silent CPU fallback — has confounded measurements twice). Only set this
# to bypass that guard for deliberate CPU-mode testing.
ARIA_ALLOW_CPU=0
